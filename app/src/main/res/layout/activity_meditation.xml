<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Meditation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meditation"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textColor="#8B27F5"
            android:padding="20dp"
            android:textStyle="bold"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/image2"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/meditation_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If you feel you have a bad health please health centers are there for you .Seek medication immediately before it becomes worse."
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/medical_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meditation"
            android:layout_margin="30dp"/>



    </LinearLayout>
</ScrollView>