<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".HydrationAlert"
        android:orientation="vertical"
        android:background="#F54927"
        android:padding="15dp">


<!--        page title-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hydration Alert"
            android:textSize="30sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:padding="20dp"
            android:layout_marginTop="20dp"/>

<!--        hydration image-->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/image3"
            android:scaleType="fitCenter"
            android:layout_margin="10dp"
            android:contentDescription="Hydration alert image"/>

<!--        current water intake-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todays water intake"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:padding="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6-8 glasses"
            android:textSize="26sp"
            android:textStyle="bold"
            android:padding="5dp"/>

<!--        hydration progress-->
        <ProgressBar
            android:id="@+id/hydration_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="8"
            android:progress="6"
            android:layout_margin="10dp"/>

<!--        daily target-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily water target - 8 glasses"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:layout_marginTop="15dp"/>

<!--        seek bar-->
        <SeekBar
            android:id="@+id/water_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="12"
            android:progress="8"
            android:layout_margin="10dp"/>

<!--        reminder switch-->
        <Switch
            android:id="@+id/hydration_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="enable hydration reminders"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:padding="10dp"/>

<!--        goal check box-->
        <CheckBox
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I have reached my daily water goal"
            android:textColor="@color/white"
            android:padding="10dp"
            android:textSize="18sp"/>

<!--        add water button-->
        <Button
            android:id="@+id/add_water"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a glass of water"
            android:backgroundTint="@color/black"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:layout_margin="10dp"/>

<!--        hydration tip-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip : Dink water regularly throughout the day"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:padding="15dp"
            android:layout_marginTop="10dp"/>






    </LinearLayout>

</ScrollView>