<!--    image view-->
    <ImageView
        android:id="@+id/homeImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/image4"
        android:layout_margin="5dp"
        android:scaleType="fitCenter"/>

<!--        banner ads-->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-3940256099942544/6300978111"/>




<!--    nutrition button-->
    <Button
        android:id="@+id/nutrition_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nutrition Advice"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#F527CF"

        />
<!--    healthy recipes-->
    <Button
        android:id="@+id/healthy_recipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Healthy Recipes"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#F5273C"/>

<!--    meditation-->
    <Button
        android:id="@+id/meditation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meditation"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#2731F5"/>

<!--    hydration alert-->
    <Button
        android:id="@+id/hydration_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hydration Alert"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#14AFDE"/>

<!--    start exercise-->
    <Button
        android:id="@+id/start_exercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Exercise"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#27E0F5"/>

<!--    daily motivation-->
    <Button
        android:id="@+id/daily_motivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Motivation"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#A627F5"/>

<!--    Weekly goals-->
    <Button
        android:id="@+id/weekly_goals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Weekly goals"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#DE5614"/>

<!--    Check progress-->
    <Button
        android:id="@+id/check_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Progress"
        android:layout_margin="5dp"
        android:textSize="20sp"
        android:backgroundTint="#148DDE"/>

    </LinearLayout>

</ScrollView>